+	if tt.HasText(f.columns[2].HeaderTooltip) {
+		t.Fatal("header tooltip appeared before 600ms")
+	}
+	tt.Advance(20 * time.Millisecond)
+	if !tt.HasText(f.columns[2].HeaderTooltip) {
+		t.Fatalf("nonempty header comment did not appear after the delay: %q", tt.Texts())
+	}

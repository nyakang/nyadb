+			tt.Frame()
+			headerGridClick(t, tt, Shift, "Gamma")
+			if removed == "alpha" {
+				headerGridColumns(t, f, "gamma", "delta")
+			} else {
+				headerGridColumns(t, f, "gamma")
+			}
+		})
+	}

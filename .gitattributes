# Keep MyGo-generated Go and locale files stable across Windows, Linux, and macOS.
# MyGo writes LF; do not let Git check these files out with CRLF on Windows.
*.go text eol=lf
/locales/*.json text eol=lf

# Unified-diff context intentionally has a leading space before tabs/blank lines.
/docs/patches/*.patch text eol=lf -whitespace
